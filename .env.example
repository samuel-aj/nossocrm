# Exemplo de variáveis de ambiente (NÃO coloque segredos aqui)
# Copie para .env.local e preencha com seus valores.

# --- Next.js / Supabase (App) ---
# URL do projeto no Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role (APENAS server-side). Necessária para alguns scripts e rotas internas dev-only.
# Nunca exponha no client e nunca comite.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dev-only ---
# Habilita rotas internas de teste de IA em desenvolvimento.
ALLOW_AI_TEST_ROUTE=false

# Habilita rotas internas de mock de UI em desenvolvimento.
ALLOW_UI_MOCKS_ROUTE=false

# --- Installer (ops only) ---
# Se INSTALLER_ENABLED nao estiver definido, o instalador fica liberado ate a primeira instalacao.
# Defina como false para desativar o instalador (recomendado apos o setup).
INSTALLER_ENABLED=false

# Token opcional para proteger o instalador (se definido, passa a ser obrigatorio).
INSTALLER_TOKEN=

# Agentes de IA / Robôs (beta): segredo que o banco (pg_net) envia no header
# X-Internal-Secret ao chamar /api/wa-agents/ingest e /tick. O mesmo valor vai em
# platform_config('wa_agents_internal_secret'). Em produção, CRON_SECRET também serve.
WA_AGENTS_INTERNAL_SECRET=

# Alertas de desconexão enviados pelo CRM. Use um remetente verificado na Resend.
RESEND_API_KEY=
WA_CONNECTION_ALERT_EMAIL_FROM=

# Notificações Web Push do celular. Gere um par VAPID por ambiente e mantenha-o estável.
# Para gerar localmente: npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_SUBJECT deve identificar um contato técnico, por exemplo mailto:suporte@example.com.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
